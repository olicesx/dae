global {
    log_level: error
}

routing {
    domain(suffix: cdn.example.net) && dport(443,8443) -> proxy(mark: 17, must)
    dip(198.51.100.0/24, '2001:db8:100::/48') -> direct
    sip(192.0.2.0/24) -> block
    l4proto(udp) && dscp(46) -> proxy
    pname(sync-agent, backup-agent) -> proxy
    mac('02:00:00:00:00:01') -> direct
    ipversion(4) -> proxy
    fallback: direct
}
